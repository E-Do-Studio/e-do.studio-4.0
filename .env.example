# Strapi CMS
VITE_STRAPI_URL=https://cms.e-do.studio
# Read-only API token for the public site (created in Strapi admin →
# Settings → API Tokens → "Read-only" type). Required since the
# users-permissions plugin was removed and there is no public role
# anymore. Without this token the site cannot read any content.
VITE_STRAPI_TOKEN=your_read_only_api_token

# Strapi Preview — see strapi/.env.example for the CMS-side variables.
# Shared secret with the Strapi admin (must match PREVIEW_SECRET on the CMS).
# The SPA reads it from the `?secret=` query the Strapi preview handler appends
# and refuses to flip into draft mode unless it matches.
VITE_PREVIEW_SECRET=your_preview_secret
# Optional dedicated API token with `Read draft` permission. Falls back to
# VITE_STRAPI_TOKEN when unset — only useful if the public token is restricted
# to published content.
VITE_STRAPI_PREVIEW_TOKEN=

# Supabase (booking API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-key

# HubSpot (CRM sync — set as Supabase Edge Function secret)
# supabase secrets set HUBSPOT_PRIVATE_APP_TOKEN=your-hubspot-private-app-token
HUBSPOT_PRIVATE_APP_TOKEN=your-hubspot-private-app-token

# Chatbot IA — secrets côté Edge Function Supabase, JAMAIS dans le bundle.
# Pose-les via :
#   supabase secrets set GEMINI_API_KEY=... CHAT_ALLOWED_ORIGIN=https://e-do.studio
# Ne PAS préfixer par VITE_ — ces clés seraient sinon bundlées côté client.
GEMINI_API_KEY=your-google-ai-studio-api-key
# Comma-separated allowlist. Defaults to https://e-do.studio,http://localhost:5173 when unset.
CHAT_ALLOWED_ORIGIN=https://e-do.studio
