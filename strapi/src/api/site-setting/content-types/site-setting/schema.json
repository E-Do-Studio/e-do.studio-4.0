{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Settings"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "siteTitle": {
      "type": "string"
    },
    "siteDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "logo": {
      "type": "media",
      "multiple": false
    },
    "phone": {
      "type": "string"
    },
    "phoneHref": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "street": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "postalCode": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "fullAddress": {
      "type": "string"
    },
    "googleMapsUrl": {
      "type": "string"
    },
    "mapsEmbedUrl": {
      "type": "string"
    },
    "latitude": {
      "type": "float"
    },
    "longitude": {
      "type": "float"
    },
    "transport": {
      "type": "component",
      "component": "shared.label-item",
      "repeatable": true
    },
    "parking": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "entries": {
      "type": "component",
      "component": "shared.address-entry",
      "repeatable": true
    },
    "hours": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "weekendHours": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "openingHoursSpec": {
      "type": "text"
    },
    "socialLinks": {
      "type": "component",
      "component": "shared.social-link",
      "repeatable": true
    },
    "bentoKeywords": {
      "type": "component",
      "component": "shared.bento-keyword",
      "repeatable": true
    },
    "defaultSeoTitle": {
      "type": "string"
    },
    "defaultSeoDescription": {
      "type": "text"
    },
    "defaultSeoImage": {
      "type": "media",
      "multiple": false
    },
    "googleAnalyticsId": {
      "type": "string"
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
