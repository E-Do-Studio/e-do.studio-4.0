{
  "kind": "collectionType",
  "collectionName": "gallery_subcategories",
  "info": {
    "singularName": "gallery-subcategory",
    "pluralName": "gallery-subcategories",
    "displayName": "Gallery Subcategory"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name_fr": { "type": "string", "required": true },
    "name_en": { "type": "string" },
    "slug": { "type": "uid", "required": true },
    "orderRank": { "type": "integer" },
    "assets": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::gallery-asset.gallery-asset",
      "mappedBy": "subcategory"
    }
  }
}
