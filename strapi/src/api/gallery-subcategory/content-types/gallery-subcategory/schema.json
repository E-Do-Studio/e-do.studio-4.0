{
  "kind": "collectionType",
  "collectionName": "gallery_subcategories",
  "info": {
    "singularName": "gallery-subcategory",
    "pluralName": "gallery-subcategories",
    "displayName": "Gallery Subcategory"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "required": true
    },
    "rank": {
      "type": "integer"
    },
    "assets": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::gallery-asset.gallery-asset",
      "mappedBy": "subcategory"
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
