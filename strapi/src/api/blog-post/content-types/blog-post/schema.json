{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog · Article",
    "description": "Article de la section Discovery du site (blog public).",
    "icon": "newspaper"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "Titre de l'article (5–120 caractères)."
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "description": "URL de l'article (auto-généré). Ne plus modifier après publication."
    },
    "publishedAt": {
      "type": "datetime",
      "description": "Date de publication éditoriale. KNOWN ISSUE — shadow le champ système Strapi (draftAndPublish). À renommer en `articleDate` lors du refactor Phase 3."
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::blog-category.blog-category",
      "inversedBy": "posts",
      "description": "Catégorie(s) associées à l'article."
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Image de couverture (1200×800 recommandé). Penser à renseigner l'alt text."
    },
    "excerpt": {
      "type": "text",
      "maxLength": 300,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "Chapeau / résumé court de l'article (≤ 300 caractères)."
    },
    "body": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "Contenu principal de l'article. À migrer en `blocks` lors du refactor Phase 3."
    },
    "cta_text": {
      "type": "string",
      "maxLength": 200,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "DEPRECATED — utiliser `ctaText` (camelCase). Ce champ sera supprimé en Phase 5 après migration des données."
    },
    "cta_label": {
      "type": "string",
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "DEPRECATED — utiliser `ctaLabel`."
    },
    "cta_url": {
      "type": "string",
      "regex": "^(https?://|/).+",
      "description": "DEPRECATED — utiliser `ctaUrl`."
    },
    "ctaText": {
      "type": "string",
      "maxLength": 200,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "Texte d'accroche du call-to-action (optionnel). Remplace `cta_text` (snake_case)."
    },
    "ctaLabel": {
      "type": "string",
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "Libellé du bouton CTA (ex: « Réserver », « En savoir plus »). Remplace `cta_label`."
    },
    "ctaUrl": {
      "type": "string",
      "regex": "^(https?://|/).+",
      "description": "URL cible du CTA. Doit commencer par http(s):// ou /. Remplace `cta_url`."
    },
    "seo_title": {
      "type": "string",
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "DEPRECATED — utiliser le composant `seo` (shared.seo-meta) ou les champs camelCase."
    },
    "seo_description": {
      "type": "text",
      "maxLength": 160,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "DEPRECATED — utiliser le composant `seo`."
    },
    "seo_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "DEPRECATED — utiliser le composant `seo`."
    },
    "seo": {
      "type": "component",
      "component": "shared.seo-meta",
      "repeatable": false,
      "description": "Métadonnées SEO mutualisées. Préférer ce champ aux `seo_*` legacy snake_case (à supprimer en Phase 4 après migration des données)."
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
