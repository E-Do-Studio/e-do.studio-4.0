{
  "kind": "collectionType",
  "collectionName": "gallery_embeds",
  "info": {
    "singularName": "gallery-embed",
    "pluralName": "gallery-embeds",
    "displayName": "Gallery Embed"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "embedUrl": {
      "type": "string",
      "required": true
    },
    "thumbnail": {
      "type": "media",
      "multiple": false
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::gallery-category.gallery-category"
    },
    "orderRank": {
      "type": "integer"
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
