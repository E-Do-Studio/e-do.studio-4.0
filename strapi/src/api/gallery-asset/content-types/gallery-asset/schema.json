{
  "kind": "collectionType",
  "collectionName": "gallery_assets",
  "info": {
    "singularName": "gallery-asset",
    "pluralName": "gallery-assets",
    "displayName": "Gallery Asset"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "image": { "type": "media", "multiple": false, "required": true },
    "alt": { "type": "string" },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::gallery-category.gallery-category",
      "inversedBy": "assets"
    },
    "subcategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::gallery-subcategory.gallery-subcategory",
      "inversedBy": "assets"
    },
    "mediaType": { "type": "enumeration", "enum": ["image", "video"] },
    "originalFilename": { "type": "string" },
    "rank": { "type": "integer" },
    "brand": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::gallery-brand.gallery-brand"
    }
  }
}
