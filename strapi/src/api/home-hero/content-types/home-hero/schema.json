    "poster": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "description": "Image poster affichée avant la lecture de la vidéo. Si vide, fallback sur public/showreel-preview.webp."
    },
    "posterAlt": {
      "type": "string",
      "maxLength": 200,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "Texte alternatif du poster (accessibilité)."
