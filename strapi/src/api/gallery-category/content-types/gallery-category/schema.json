{
  "kind": "collectionType",
  "collectionName": "gallery_categories",
  "info": {
    "singularName": "gallery-category",
    "pluralName": "gallery-categories",
    "displayName": "Gallery Category"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "required": true
    },
    "group": {
      "type": "enumeration",
      "enum": [
        "live",
        "eclipse",
        "ghost",
        "pique",
        "horizontal",
        "vertical",
        "packshot",
        "cyclorama",
        "post-prod"
      ]
    },
    "rank": {
      "type": "integer"
    }
  }
}
