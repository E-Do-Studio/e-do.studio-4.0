{
  "kind": "collectionType",
  "collectionName": "gallery_categories",
  "info": {
    "singularName": "gallery-category",
    "pluralName": "gallery-categories",
    "displayName": "Gallery Category"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "required": true
    },
    "group": {
      "type": "enumeration",
      "enum": [
        "live",
        "eclipse",
        "ghost",
        "pique",
        "horizontal",
        "vertical",
        "packshot",
        "cyclorama",
        "post-prod"
      ]
    },
    "orderRank": {
      "type": "integer"
    },
    "assets": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::gallery-asset.gallery-asset",
      "mappedBy": "category"
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
