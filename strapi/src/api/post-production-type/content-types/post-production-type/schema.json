{
  "kind": "collectionType",
  "collectionName": "post_production_types",
  "info": {
    "singularName": "post-production-type",
    "pluralName": "post-production-types",
    "displayName": "Post-prod · Type",
    "description": "Prestation de post-production (retouche, ghost, détourage, etc.). Ordonnable par drag & drop.",
    "icon": "scissors"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "Nom de la prestation (ex: « On model », « Ghost »)."
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "description": "Identifiant URL (auto-généré)."
    },
    "description": {
      "type": "text",
      "maxLength": 600,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "Description de la prestation (accroche éditoriale)."
    },
    "price": {
      "type": "string",
      "maxLength": 100,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "ATTENTION : actuellement parsé en regex côté front (`parsePriceText`). À refactorer en `pricing-row` (Phase 3). Format : « À partir de 7,90€ », « Sur devis »."
    },
    "priceRows": {
      "type": "component",
      "component": "shared.pricing-row",
      "repeatable": true,
      "description": "Tarification structurée — remplace progressivement le champ `price`. Tant que vide, le front continue de lire `price`."
    },
    "includes": {
      "type": "component",
      "component": "shared.localized-item",
      "repeatable": true,
      "description": "Ce qui est inclus dans la prestation (liste à puces)."
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Image illustrative de la prestation."
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"],
      "description": "Galerie d'exemples avant/après."
    },
    "rank": {
      "type": "integer",
      "configurable": false
    },
    "seo": {
      "type": "component",
      "component": "shared.seo-meta",
      "repeatable": false,
      "description": "Métadonnées SEO de la page post-production."
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
