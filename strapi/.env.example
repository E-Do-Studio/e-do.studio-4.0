# Runtime environment. Strapi uses this to load config/env/<NODE_ENV>/* overrides.
NODE_ENV=development

# Server
HOST=0.0.0.0
PORT=1337
# Public-facing URL of the Strapi server. In prod, set to https://cms.e-do.studio
PUBLIC_URL=http://localhost:1337
# Set to true when Strapi runs behind a reverse proxy / CDN (Nginx, Cloudflare, etc.)
# so ctx.request.ip, ctx.request.protocol and secure cookies are computed correctly.
IS_PROXIED=false

# Strapi secrets — generate fresh values per environment, never reuse across envs.
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (see config/database.ts). DATABASE_CLIENT picks the connection block.
# Supported clients: sqlite (default, dev only), postgres, mysql.
DATABASE_CLIENT=sqlite
# sqlite — file relative to repo root
DATABASE_FILENAME=.tmp/data.db
# postgres / mysql — either DATABASE_URL OR the discrete vars below
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SCHEMA=public
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT=60000

# Cloudflare R2 upload provider (see config/plugins.ts).
# CF_ACCOUNT_ID is your Cloudflare account ID, used to build the S3 endpoint URL.
# CF_PUBLIC_URL is the public-facing R2 bucket URL (e.g. https://pub-<id>.r2.dev or a custom domain).
CF_ACCOUNT_ID=
CF_ACCESS_KEY_ID=
CF_ACCESS_SECRET=
CF_BUCKET_NAME=
CF_PUBLIC_URL=

# Strapi admin UI flags. Defaults are false in code — set true here only for local dev if desired.
# FLAG_NPS=false
# FLAG_PROMOTE_EE=false
