# ─── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337
# Public URL of the Strapi instance (used for absolute URLs, admin, etc.)
PUBLIC_URL=http://localhost:1337

# ─── Secrets — generate every value below; never commit real values ─────────
# Generate with: openssl rand -base64 32
APP_KEYS="replace-with-comma-separated-random-values"
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me
ENCRYPTION_KEY=replace-me

# ─── Database ───────────────────────────────────────────────────────────────
# Supported clients: sqlite (default, dev only), postgres, mysql
DATABASE_CLIENT=postgres
# Either set DATABASE_URL OR the discrete DATABASE_HOST/PORT/NAME/USERNAME/PASSWORD vars.
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=replace-me
DATABASE_SCHEMA=public
DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT=60000
# sqlite only:
# DATABASE_FILENAME=.tmp/data.db

# ─── Cloudflare R2 (upload provider) ────────────────────────────────────────
# Cloudflare account ID (subdomain of r2.cloudflarestorage.com)
CF_ACCOUNT_ID=
# R2 access key pair (rotate via the Cloudflare dashboard, not git)
CF_ACCESS_KEY_ID=
CF_ACCESS_SECRET=
CF_BUCKET_NAME=website
# Public CDN base URL for served assets (e.g. https://cdn.e-do.studio)
CF_PUBLIC_URL=
