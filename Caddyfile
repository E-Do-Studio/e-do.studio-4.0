:80 {
    root * /srv
    encode zstd gzip

    # ---------- Force HTTPS (audit: LOAD_PAGE_OVER_HTTPS) ----------
    # TLS terminates at the Coolify proxy, which forwards over plain HTTP to this
    # container on :80 and sets X-Forwarded-Proto. When the visitor's original
    # scheme was http, redirect to https. On https the header reads "https" so
    # this never fires — no redirect loop. Runs first so every other directive
    # only ever sees secured requests.
    @forwarded-http header X-Forwarded-Proto http
    redir @forwarded-http https://{host}{uri} 301

    # ---------- Redirections legacy v3 → v4 (301 permanent) ----------

    @root path /
    redir @root /fr 301

    redir /cyclorama   /fr/cyclorama 301
    redir /contact     /fr/contact   301
    redir /legal       /fr/legal     301
    redir /reservation /fr/reserver  301
    redir /faq         /fr/discovery 301

    redir /services/horizontal /fr/plateau/horizontal 301
    redir /services/vertical   /fr/plateau/vertical   301
    redir /services/eclipse    /fr/plateau/eclipse    301
    redir /services/live       /fr/plateau/live       301

    redir /post-production/lookbook        /fr/post-production?type=lookbook 301
    redir /post-production/high_end        /fr/post-production?type=high_end 301
    redir /post-production/access          /fr/post-production?type=access   301
    redir /post-production/flat            /fr/post-production?type=flat     301
    redir /post-production/ghost           /fr/post-production?type=ghost    301
    redir /post-production/pique           /fr/post-production?type=pique    301
    redir /post-production/retouche-video  /fr/post-production               301
    redir /post-production                 /fr/post-production               301

    @galerie_cat {
        path /galerie
        query category=*
    }
    redir @galerie_cat /fr/galerie?cat={http.request.uri.query.category} 301
    redir /galerie /fr/galerie 301

    # /en/galerie was the original EN route; renamed to /en/gallery for natural
    # localization (see EDO SEO audit 4.5). 301 keeps any indexed link alive.
    redir /en/galerie /en/gallery 301

    # ---------- /Redirections legacy ----------

    # ===== 410 Gone — URLs explicitement retirées =====
    # Infrastructure prête. À étendre au cas par cas quand on supprime une URL
    # publique connue (ex: ancien article promu puis dépublié).
    # @gone path /exemple-url-supprimee
    # respond @gone "Gone" 410 {
    #     close
    # }

    # ===== 503 Maintenance — togglable via env CADDY_MAINTENANCE=true =====
    # Coupe le site en gardant un message clair pour visiteurs et un Retry-After
    # pour les crawlers. Activé en posant la variable d'env au lancement Caddy.
    @maintenance expression `{env.CADDY_MAINTENANCE} == "true"`
    handle @maintenance {
        rewrite * /503.html
        file_server {
            status 503
        }
        header Retry-After "3600"
    }

    # ===== Top-level inconnu → vrai HTTP 404 =====
    # Désormais géré par l'application : le garde `beforeLoad` de la route
    # $lang (src/routes/$lang/route.tsx) répond 404 pour tout premier segment
    # qui n'est pas une langue, et le SSR renvoie le bon statut HTTP. Plus de
    # règle dupliquée ici, ni de soft 404.

    # Les en-têtes de cache des assets sont posés par le serveur Node
    # (server.mjs) : /assets/* est content-addressed donc immuable, le reste
    # des fichiers statiques a un cache plus court.
    @static path /fonts/* /*.woff2 /*.woff /*.ttf /*.otf /*.avif /*.webp /*.jpg /*.jpeg /*.png /*.svg /*.ico /*.mp4 /*.webm
    header @static Access-Control-Allow-Origin "*"

    header {
        # Lighthouse "Best Practices" + standard hardening.
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        Cross-Origin-Opener-Policy same-origin
        X-Frame-Options DENY
        # CSP allows the Strapi CMS, Supabase Edge Function, the Google Maps iframe on
        # the contact page, and the marketing/analytics stack fired through GTM:
        # GA4 (all regional `*.google-analytics.com` + `*.analytics.google.com`),
        # Google Ads Conversion Linker (`googleadservices.com`, `*.g.doubleclick.net`,
        # `google.com`/`google.fr` audiences), and HubSpot (tracker, forms, banner).
        # Everything else is locked down.
        # 'unsafe-inline' on style-src is required for Tailwind v4 runtime CSS variables.
        # 'unsafe-inline' on script-src is required by the GTM bootstrap snippet (Google's
        # standard inline loader); the JSON-LD <script type="application/ld+json"> isn't
        # executable so it doesn't need it, but GTM does.
        # TEMP: CSP désactivée le temps de débugger le tag assistant + GTM — à réactiver.
        # Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.googletagmanager.com https://*.google-analytics.com https://www.googleadservices.com https://*.g.doubleclick.net https://*.hs-scripts.com https://*.hs-analytics.net https://*.hs-banner.com https://*.hsadspixel.net https://*.hsforms.net https://*.hscollectedforms.net https://*.hsappstatic.net https://*.hubspot.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://cms.e-do.studio https://pub-9b79de66b20440cdb7e8bae53605296c.r2.dev https://*.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net https://www.googleadservices.com https://www.google.com https://www.google.fr https://*.hubspot.com https://*.hsforms.com; media-src 'self' https://cms.e-do.studio https://pub-9b79de66b20440cdb7e8bae53605296c.r2.dev; connect-src 'self' https://cms.e-do.studio https://pub-9b79de66b20440cdb7e8bae53605296c.r2.dev https://*.supabase.co https://*.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net https://www.googleadservices.com https://www.google.com https://www.google.fr https://*.hubspot.com https://*.hubapi.com https://*.hsforms.com https://*.hscollectedforms.net https://*.hsappstatic.net https://*.hs-analytics.net; frame-src https://www.google.com https://*.googletagmanager.com https://td.doubleclick.net https://*.hsforms.net https://*.hsforms.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        -Server
    }

    # Strapi Preview entry: when the URL carries ?preview=1, allow the CMS
    # admin to embed the SPA in its preview iframe. The flag is non-secret on
    # its own — the SPA still validates ?secret=… against VITE_PREVIEW_SECRET
    # before swapping fetches to draft mode. Subsequent client-side navigation
    # inside the iframe stays in the same document, so the relaxed framing on
    # the initial HTML response is enough.
    @preview query preview=1
    header @preview -X-Frame-Options
    # Preview entries must never be indexed if a draft URL ever leaks (Strapi
    # admin share, internal Slack, etc.). Belt-and-braces alongside the SPA's
    # in-app banner — non-JS crawlers will only see this header.
    header @preview X-Robots-Tag "noindex, nofollow"
    # TEMP: CSP désactivée le temps de débugger le tag assistant + GTM — à réactiver.
    # header @preview Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.googletagmanager.com https://*.google-analytics.com https://www.googleadservices.com https://*.g.doubleclick.net https://*.hs-scripts.com https://*.hs-analytics.net https://*.hs-banner.com https://*.hsadspixel.net https://*.hsforms.net https://*.hscollectedforms.net https://*.hsappstatic.net https://*.hubspot.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://cms.e-do.studio https://pub-9b79de66b20440cdb7e8bae53605296c.r2.dev https://*.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net https://www.googleadservices.com https://www.google.com https://www.google.fr https://*.hubspot.com https://*.hsforms.com; media-src 'self' https://cms.e-do.studio https://pub-9b79de66b20440cdb7e8bae53605296c.r2.dev; connect-src 'self' https://cms.e-do.studio https://pub-9b79de66b20440cdb7e8bae53605296c.r2.dev https://*.supabase.co https://*.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net https://www.googleadservices.com https://www.google.com https://www.google.fr https://*.hubspot.com https://*.hubapi.com https://*.hsforms.com https://*.hscollectedforms.net https://*.hsappstatic.net https://*.hs-analytics.net; frame-src https://www.google.com https://*.googletagmanager.com https://td.doubleclick.net https://*.hsforms.net https://*.hsforms.com; frame-ancestors https://cms.e-do.studio; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

    # Le rendu est fait par TanStack Start côté serveur, à chaque requête.
    # Caddy ne sert plus de fichiers : il reste devant pour les redirections
    # 301 legacy, les en-têtes de sécurité et le mode maintenance, et passe
    # tout le reste — pages comme assets — au process Node (server.mjs).
    reverse_proxy {env.APP_UPSTREAM}

    # ===== handle_errors — filet quand l'upstream ne répond pas =====
    # Les 404 viennent maintenant de l'application (SSR, vrai statut HTTP) et
    # traversent le reverse_proxy tels quels : plus de branche 404 ici. Ne
    # reste que le cas où Node est indisponible — Caddy sert alors une page
    # statique locale plutôt que son erreur par défaut.
    handle_errors {
        @5xx expression `{err.status_code} >= 500`
        handle @5xx {
            rewrite * /500.html
            file_server {
                status 500
            }
        }
    }
}
